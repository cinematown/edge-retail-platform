#!/bin/sh
set -eu
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
WRAPPER_JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
WRAPPER_VERSION=8.14.3
if [ ! -f "$WRAPPER_JAR" ]; then
  command -v curl >/dev/null 2>&1 || {
    echo "curl is required to bootstrap the Gradle wrapper." >&2
    exit 1
  }
  TMP_JAR="$WRAPPER_JAR.tmp"
  TMP_SUM="$WRAPPER_JAR.sha256.tmp"
  mkdir -p "$(dirname "$WRAPPER_JAR")"
  curl --fail --location --silent --show-error \
    "https://services.gradle.org/distributions/gradle-${WRAPPER_VERSION}-wrapper.jar" \
    --output "$TMP_JAR"
  curl --fail --location --silent --show-error \
    "https://services.gradle.org/distributions/gradle-${WRAPPER_VERSION}-wrapper.jar.sha256" \
    --output "$TMP_SUM"
  EXPECTED=$(tr -d '[:space:]' < "$TMP_SUM")
  ACTUAL=$(sha256sum "$TMP_JAR" | awk '{print $1}')
  rm -f "$TMP_SUM"
  if [ "$EXPECTED" != "$ACTUAL" ]; then
    rm -f "$TMP_JAR"
    echo "Gradle wrapper checksum verification failed." >&2
    exit 1
  fi
  mv "$TMP_JAR" "$WRAPPER_JAR"
fi
exec java -classpath "$WRAPPER_JAR" org.gradle.wrapper.GradleWrapperMain "$@"
