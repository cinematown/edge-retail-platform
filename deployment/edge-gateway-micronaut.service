[Unit]
Description=Edge Retail Micronaut Gateway
After=network-online.target mosquitto.service mysql.service
Wants=network-online.target

[Service]
Type=simple
User=edge-retail
Group=edge-retail
WorkingDirectory=/opt/edge-retail-platform/gateway-micronaut
EnvironmentFile=/opt/edge-retail-platform/.env
ExecStart=/opt/edge-retail-platform/gateway-micronaut/build/install/edge-retail-gateway-micronaut/bin/edge-retail-gateway-micronaut
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
